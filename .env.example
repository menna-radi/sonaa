# ============================================================
# Sonaa Admin Dashboard — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# API Base URL (no trailing slash)
VITE_API_BASE_URL=https://api.arox.digital/api/v1

# Request timeout in milliseconds
VITE_API_TIMEOUT=10000

# Set to "true" to use mock data instead of real API (default: false)
VITE_USE_MOCK=false
